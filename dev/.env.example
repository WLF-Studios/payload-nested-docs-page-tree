# Payload dev playground
DATABASE_URL=mongodb://127.0.0.1/payload-nested-docs-page-tree
PAYLOAD_SECRET=change-me

# Cloudflare deploy trigger used by dev/lib/rebuild.ts
# Leave empty to disable publish/delete deploy hooks locally.
CLOUDFLARE_DEPLOY_HOOK_URL=

# Cloudflare build status badge used by payload-cloudflare-build-status
# Required for the admin badge to show real build status.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Use either CF_WORKER_TAG or CF_WORKER_NAME.
CF_WORKER_TAG=
CF_WORKER_NAME=

# Optional public frontend URL shown by the Cloudflare status badge.
PUBLIC_SITE_URL=
